+// Loss threshold from 0 - 1000
+#define TCP_META_LOSS_HIGH_PERMILLE 10 // 1%
+#define TCP_META_LOSS_LOW_PERMILLE 3 // .3 %
+
+#define TCP_META_ECN_HIGH_PERMILLE 50 // 5%
+
+// RTT thresholds
+#define TCP_META_DC_RTT_MAX_US 250 // datacenter ish if base_rtt < 250 us
+#define TCP_META_LFN_RTT_MIN_US \
+	40000 // high bandwidth delay product if base_rtt > 40 ms
+
+// EWMA helper
+static inline u32 meta_ewma(u32 old, u32 sample)
+{
+	if (!old)
+		return sample;
+	return ((old << TCP_META_EWMA_SHIFT) - old + sample) >>
+	       TCP_META_EWMA_SHIFT;
+}
+
+enum tcp_meta_env {
+	TCP_META_ENV_UNKNOWN = 0,
+	TCP_META_ENV_DATACENTER_ECN,
+	TCP_META_ENV_WIRELESS,
+	TCP_META_ENV_HIGH_BDP,
+	TCP_META_ENV_INTERNET
+};
+
+static enum tcp_meta_env tcp_meta_classify_env(struct tcp_sock *tp)
+{
+	struct tcp_meta_state *m = &tp->tcp_meta_state;
+	u32 base_rtt = m->base_rtt_us;
+	u32 qdelay = m->qdelay_ewma_us;
+	u32 loss = m->loss_ewma;
+	u32 ecn = m->ecn_ewma;
+
+	if (!base_rtt)
+		return TCP_META_ENV_UNKNOWN;
+
+	/* Datacenter with ECN: very low RTT + noticeable ECN ratio */
+	if (base_rtt < TCP_META_DC_RTT_MAX_US &&
+	    ecn > TCP_META_ECN_HIGH_PERMILLE)
+		return TCP_META_ENV_DATACENTER_ECN;
+
+	/* Wireless / random-loss: high loss, but qdelay not huge */
+	if (loss > TCP_META_LOSS_HIGH_PERMILLE &&
+	    qdelay < base_rtt * TCP_META_QDELAY_GOOD_FACTOR)
+		return TCP_META_ENV_WIRELESS;
+
+	/* High-BDP LFN: base RTT large, loss low */
+	if (base_rtt > TCP_META_LFN_RTT_MIN_US &&
+	    loss < TCP_META_LOSS_LOW_PERMILLE)
+		return TCP_META_ENV_HIGH_BDP;
+
+	/* Otherwise call it “generic Internet” */
+	return TCP_META_ENV_INTERNET;
+}
+
+static const char *tcp_meta_choose_algo(struct sock *sk)
+{
+	struct tcp_sock *tp = tcp_sk(sk);
+	struct inet_connection_sock *icsk = inet_csk(sk);
+	struct tcp_meta_state *m = &tp->tcp_meta_state;
+	enum tcp_meta_env env;
+	u32 base_rtt = m->base_rtt_us;
+	u32 qdelay = m->qdelay_ewma_us;
+	u32 loss = m->loss_ewma;
+	// u32 ecn = m->ecn_ewma;
+	const char *cur_name = icsk->icsk_ca_ops->name;
+
+	env = tcp_meta_classify_env(tp);
+
+	/* Safety: if we don't even have a base_rtt yet, don't change. */
+	if (!base_rtt)
+		return cur_name;
+
+	switch (env) {
+	case TCP_META_ENV_DATACENTER_ECN:
+		/* ECN + short RTT: DCTCP is king here */
+		if (strcmp(cur_name, "dctcp") != 0)
+			return "dctcp";
+		break;
+
+	case TCP_META_ENV_WIRELESS:
+		/*
+		 * Wireless/random-loss: prefer Westwood or Veno.
+		 * If we are on something loss-only (reno/cubic), upgrade.
+		 */
+		if (strcmp(cur_name, "westwood") && strcmp(cur_name, "veno")) {
+			/* Pick one as your default: */
+			return "westwood";
+		}
+		break;
+
+	case TCP_META_ENV_HIGH_BDP:
+		/*
+		 * High-BDP LFN:
+		 * - If qdelay is not too huge → BBR for low-latency, high throughput.
+		 * - If qdelay is large → Illinois as high-speed loss/delay hybrid.
+		 */
+		if (qdelay < base_rtt * TCP_META_QDELAY_GOOD_FACTOR) {
+			if (strcmp(cur_name, "bbr") != 0)
+				return "bbr";
+		} else {
+			if (strcmp(cur_name, "illinois") != 0)
+				return "illinois";
+		}
+		break;
+
+	case TCP_META_ENV_INTERNET:
+	default:
+		/*
+		 * Generic Internet:
+		 * - If qdelay is small and loss low → BBR (good latency & throughput)
+		 * - If persistent high qdelay or loss → fall back to CUBIC
+		 */
+		if (qdelay < base_rtt * TCP_META_QDELAY_GOOD_FACTOR &&
+		    loss < TCP_META_LOSS_HIGH_PERMILLE) {
+			if (strcmp(cur_name, "bbr") != 0)
+				return "bbr";
+		} else {
+			if (strcmp(cur_name, "cubic") != 0)
+				return "cubic";
+		}
+		break;
+	}
+
+	/* If we reach here, stay on current algo */
+	return cur_name;
+}
+
+/* Mircea Helper functions */
+static inline enum tcp_meta_algo
+tcp_meta_detect_algo(const struct inet_connection_sock *icsk)
+{
+	const struct tcp_congestion_ops *ca = icsk->icsk_ca_ops;
+	const char *name;
+
+	if (!ca || !ca->name)
+		return TCP_META_ALGO_UNKNOWN;
+
+	name = ca->name;
+
+	if (!strcmp(name, "bbr") || !strcmp(name, "bbr2"))
+		return TCP_META_ALGO_BBR;
+
+	if (!strcmp(name, "cubic"))
+		return TCP_META_ALGO_CUBIC;
+
+	if (!strcmp(name, "reno") || !strcmp(name, "newreno"))
+		return TCP_META_ALGO_RENO;
+
+	if (!strcmp(name, "dctcp"))
+		return TCP_META_ALGO_DCTCP;
+
+	if (!strcmp(name, "westwood"))
+		return TCP_META_ALGO_WESTWOOD;
+
+	if (!strcmp(name, "highspeed"))
+		return TCP_META_ALGO_HIGHSPEED;
+
+	if (!strcmp(name, "htcp"))
+		return TCP_META_ALGO_HTCP;
+
+	if (!strcmp(name, "vegas"))
+		return TCP_META_ALGO_VEGAS;
+
+	if (!strcmp(name, "veno"))
+		return TCP_META_ALGO_VENO;
+
+	if (!strcmp(name, "yeah"))
+		return TCP_META_ALGO_YEAH;
+
+	if (!strcmp(name, "illinois"))
+		return TCP_META_ALGO_ILLINOIS;
+
+	return TCP_META_ALGO_UNKNOWN;
+}
+
+static inline const char *tcp_meta_algo_name(enum tcp_meta_algo algo)
+{
+	switch (algo) {
+	case TCP_META_ALGO_RENO:
+		return "reno";
+	case TCP_META_ALGO_CUBIC:
+		return "cubic";
+	case TCP_META_ALGO_BBR:
+		return "bbr";
+	case TCP_META_ALGO_DCTCP:
+		return "dctcp";
+	case TCP_META_ALGO_WESTWOOD:
+		return "westwood";
+	case TCP_META_ALGO_HIGHSPEED:
+		return "highspeed";
+	case TCP_META_ALGO_HTCP:
+		return "htcp";
+	case TCP_META_ALGO_VEGAS:
+		return "vegas";
+	case TCP_META_ALGO_VENO:
+		return "veno";
+	case TCP_META_ALGO_YEAH:
+		return "yeah";
+	case TCP_META_ALGO_ILLINOIS:
+		return "illinois";
+	case TCP_META_ALGO_UNKNOWN:
+	default:
+		return "other";
+	}
+}
+
+static void tcp_meta_controller(struct sock *sk)
+{
+	/* Global gate: do nothing if disabled */
+	if (!sysctl_tcp_meta_enable)
+		return;
+
+	struct tcp_sock *tp = tcp_sk(sk);
+	struct inet_connection_sock *icsk = inet_csk(sk);
+	unsigned long now = jiffies;
+	u32 rtt_us, base_rtt, qdelay;
+	enum tcp_meta_algo algo_now;
+
+	/* Keep meta state in sync with the real CC algorithm */
+	algo_now = tcp_meta_detect_algo(icsk);
+	tp->tcp_meta_state.current_algo = algo_now;
+
+	/* First-time init per flow when meta is globally enabled */
+	if (!tp->tcp_meta_state.enabled) {
+		tp->tcp_meta_state.enabled = 1;
+		tp->tcp_meta_state.badness = 0;
+		tp->tcp_meta_state.last_switch_jiffies = now;
+		tp->tcp_meta_state.base_rtt_us = 0;
+
+		pr_info("Meta-CC: init flow with algo=%s (meta=%s)\n",
+			icsk->icsk_ca_ops->name, tcp_meta_algo_name(algo_now));
+	}
+
+	/* We need an RTT sample */
+	if (!tp->srtt_us)
+		return;
+
+	/* tp->srtt_us is RTT << 3 in usecs → shift back */
+	rtt_us = tp->srtt_us >> 3;
+	if (!rtt_us)
+		return;
+
+	base_rtt = tp->tcp_meta_state.base_rtt_us;
+	if (!base_rtt || rtt_us < base_rtt)
+		tp->tcp_meta_state.base_rtt_us = base_rtt = rtt_us;
+
+	/* queueing delay estimate */
+	if (rtt_us > base_rtt)
+		qdelay = rtt_us - base_rtt;
+	else
+		qdelay = 0;
+
+	/* Simple “badness” metric: large persistent queuing delay */
+	if (qdelay > TCP_META_QDELAY_FACTOR * base_rtt)
+		tp->tcp_meta_state.badness++;
+	else if (tp->tcp_meta_state.badness > 0)
+		tp->tcp_meta_state.badness--;
+
+	if (tp->tcp_meta_state.badness < TCP_META_BADNESS_LIMIT)
+		return;
+
+	/* Don’t switch too often */
+	if (time_before(now, tp->tcp_meta_state.last_switch_jiffies +
+				     TCP_META_MIN_SWITCH))
+		return;
+
+	struct tcp_meta_state *m = &tp->tcp_meta_state;
+
+	/* EWMA qdelay and basic variance */
+	m->qdelay_ewma_us = meta_ewma(m->qdelay_ewma_us, qdelay);
+	if (base_rtt > 0 && rtt_us > base_rtt)
+		m->rtt_var_us = meta_ewma(m->rtt_var_us, rtt_us - base_rtt);
+
+	/* Track ECN and loss on a per-interval basis */
+	{
+		u32 delivered = tp->delivered - m->last_delivered;
+		u32 delivered_ce = tp->delivered_ce - m->last_delivered_ce;
+		u32 total_retrans = tp->total_retrans - m->last_total_retrans;
+
+		m->last_delivered = tp->delivered;
+		m->last_delivered_ce = tp->delivered_ce;
+		m->last_total_retrans = tp->total_retrans;
+
+		/* ECN ratio in permille */
+		if (delivered > 0 && delivered_ce <= delivered) {
+			u32 ecn_sample = (delivered_ce * 1000) / delivered;
+			m->ecn_ewma = meta_ewma(m->ecn_ewma, ecn_sample);
+		}
+
+		/* Loss ratio in permille */
+		if (delivered + total_retrans > 0 &&
+		    total_retrans <= delivered + total_retrans) {
+			u32 loss_sample = (total_retrans * 1000) /
+					  (delivered + total_retrans);
+			m->loss_ewma = meta_ewma(m->loss_ewma, loss_sample);
+		}
+	}
+
+	if (tp->tcp_meta_state.badness < TCP_META_BADNESS_LIMIT)
+		return;
+
+	if (time_before(now, m->last_switch_jiffies + TCP_META_MIN_SWITCH))
+		return;
+
+	// Decide the next algorithm based on env+metrics
+	const char *old_name = icsk->icsk_ca_ops->name;
+	const char *next_name = tcp_meta_choose_algo(sk);
+
+	// No-op if policy says to stay
+	if (!strcmp(old_name, next_name))
+		return;
+
+	enum tcp_meta_algo old_meta = tp->tcp_meta_state.current_algo;
+	enum tcp_meta_algo new_meta;
+	const char *new_name;
+	bool load = false;
+	bool cap = true; // ignore CAP_NET_ADMIN for "research"
+
+	if (!tcp_set_congestion_control(sk, next_name, load, cap)) {
+		// Successful switch; reset state
+		icsk = inet_csk(sk);
+		m->last_switch_jiffies = now;
+		m->badness = 0;
+
+		new_name = icsk->icsk_ca_ops->name;
+		new_meta = tcp_meta_detect_algo(icsk);
+		m->current_algo = new_meta;
+
+		pr_info("Meta-CC: switching from %s (meta=%s) to %s (meta=%s)\n",
+			old_name, tcp_meta_algo_name(old_meta), new_name,
+			tcp_meta_algo_name(new_meta));
+	} else {
+		pr_warn("Meta-CC: switch FAILED to %s (algo=%s/meta=%s)\n",
+			next_name, icsk->icsk_ca_ops->name,
+			tcp_meta_algo_name(m->current_algo));
+		m->enabled = 0;
+	}
+}
